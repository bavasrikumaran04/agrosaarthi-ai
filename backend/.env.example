# =============================================================================
# AgroSaarthi AI backend — example environment.
# Copy to backend/.env for LOCAL development only (git-ignored). In production set
# these in your hosting provider's secret manager. Never commit real values.
# Every variable is validated at startup (src/config/); invalid configuration
# stops the server with a list of problems (values are never printed).
# Full reference: docs/ENVIRONMENT_VARIABLES.md
# =============================================================================

# --- Core --------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=4000
HOST=0.0.0.0
# Public HTTPS URL of this API. REQUIRED in production (webhook signatures, signed file URLs).
PUBLIC_BASE_URL=
# Comma-separated CORS allowlist of frontend origins (scheme://host[:port]).
FRONTEND_ORIGINS=http://localhost:4200
# Reverse-proxy hops to trust for client IPs (most PaaS hosts: 1).
TRUST_PROXY=0
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace|silent (debug/trace refused in production)
# LOG_PRETTY=true                    # human-readable logs (default true in development)
REQUEST_TIMEOUT_MS=30000
SLOW_REQUEST_MS=3000
JSON_BODY_LIMIT=100kb
SHUTDOWN_GRACE_MS=10000
# API_DOCS_ENABLED=true              # Swagger UI at /api/docs (default: off in production)

# --- Database ----------------------------------------------------------------
# Local: run `npm run dev:mongo` (no MongoDB install needed) or point to your own server.
MONGODB_URI=mongodb://127.0.0.1:27017/agrosaarthi
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGODB_AUTO_INDEX=true            # set false in large deployments and run `npm run db:indexes`

# --- Authentication -----------------------------------------------------------
# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE=true                 # default true in production, false otherwise
# Use "none" only when frontend and API are on different sites (requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_HASH_MEMORY_KIB=19456       # argon2id; production refuses < 19456
PASSWORD_HASH_TIME_COST=2

# --- Personal-data protection & rate limits ------------------------------------
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored phone numbers unrecoverable — back it up in your secret manager.
DATA_ENCRYPTION_KEY=
# >= 32 random characters (HMAC key for phone-number lookup hashes).
DATA_HASH_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=600

# --- File storage --------------------------------------------------------------
# local: filesystem (development only unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true on a persistent disk)
# s3:    any private S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
# >= 32 random characters; signs short-lived file URLs.
SIGNED_URL_SECRET=
SIGNED_URL_TTL_SECONDS=300
# S3_BUCKET=
# S3_REGION=                         # e.g. ap-south-1, or "auto" for Cloudflare R2
# S3_ENDPOINT=                       # only for S3-compatible services (e.g. https://<account>.r2.cloudflarestorage.com)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Conversational AI -----------------------------------------------------------
# gemini | development (SIMULATOR, refused in production) | none (source excerpts only, no AI)
AI_PROVIDER=development
# GEMINI_API_KEY=
# GEMINI_MODEL=                      # exact model id — see docs/research/gemini-api.md
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=4
AI_MAX_OUTPUT_TOKENS=1024
AI_DAILY_REQUEST_QUOTA_PER_USER=60
AI_DAILY_REQUEST_QUOTA_GLOBAL=5000
ASSISTANT_MAX_TURNS_PER_SESSION=30
ASSISTANT_CONTEXT_TURNS=8
ASSISTANT_MAX_QUESTION_CHARS=1500

# --- Crop-disease image model ----------------------------------------------------
# model-service (Python service in model-service/) | simulated (SIMULATOR, refused in production) | none
IMAGE_MODEL_PROVIDER=simulated
# MODEL_SERVICE_URL=http://127.0.0.1:8000
# MODEL_SERVICE_TOKEN=               # shared secret, >= 16 chars, same value as the model service's token
MODEL_SERVICE_TIMEOUT_MS=20000
IMAGE_MAX_BYTES=8388608
IMAGE_MIN_DIMENSION=128
IMAGE_MAX_PIXELS=40000000

# --- Speech (provider adapters documented in docs/VOICE_PIPELINE.md) --------------
STT_PROVIDER=simulated               # none | simulated (refused in production) | real providers when configured
TTS_PROVIDER=simulated
AUDIO_MAX_BYTES=5242880
AUDIO_MAX_SECONDS=60
SPEECH_TIMEOUT_MS=20000

# --- Telephony (docs/TELEPHONY.md) --------------------------------------------------
TELEPHONY_PROVIDER=none
# The simulator never places or receives real calls; sessions are marked isSimulated.
TELEPHONY_SIMULATOR_ENABLED=true
# >= 32 random characters; signs simulator webhook requests.
TELEPHONY_SIMULATOR_SECRET=
# ALLOW_TELEPHONY_SIMULATOR_IN_PRODUCTION=false

# --- Data retention (docs/DATA_RETENTION.md) ----------------------------------------
RETENTION_CONVERSATION_DAYS=90
RETENTION_CROP_IMAGE_DAYS=365
RETENTION_VOICE_INPUT_HOURS=24
RETENTION_TTS_AUDIO_HOURS=24
RETENTION_CALL_RECORDING_DAYS=7
RETENTION_CALL_SESSION_DAYS=180
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_WEBHOOK_EVENT_HOURS=48
RETENTION_PROVIDER_HEALTH_DAYS=30
