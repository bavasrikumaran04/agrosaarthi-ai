# --- Secrets: never commit real environment files ---
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
gcp-credentials*.json

# --- Dependencies & build output ---
node_modules/
dist/
build/
out-tsc/
.angular/
coverage/
*.tsbuildinfo

# --- Runtime data: farmer uploads, generated audio, call recordings ---
backend/storage/
backend/uploads/
storage/
uploads/
recordings/
*.wav
*.mp3
*.ogg
*.webm
!**/test/fixtures/**/*.wav

# --- ML: datasets, caches and model weights stay out of Git ---
ml/data/
ml/artifacts/
ml/cache/
ml/.venv/
model-service/.venv/
model-service/models/
*.onnx
*.pt
*.pth
*.safetensors
*.ckpt
*.npz
*.npy

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# --- Test & tool output ---
playwright-report/
test-results/
e2e/.auth/
*.log
logs/
.tools/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
